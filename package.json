{
  "name": "woh",
  "version": "1.0.0",
  "description": "World of Hyrule — micro-voxel RTS diorama (Project PaperCraft)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry": "npm run build && wrangler deploy --dry-run",
    "format": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "homepage": "https://woh.ibm.io",
  "keywords": [
    "rts",
    "voxel",
    "world-of-hyrule",
    "papercraft",
    "woh",
    "ibm.io"
  ],
  "author": "PaperCraft Team",
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.164.0"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "bitecs": "^0.4.0",
    "postprocessing": "^6.39.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  }
}
